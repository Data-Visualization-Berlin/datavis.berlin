{{- $ctx := .context -}}
{{- $format := .format -}}
{{- $pages := where $ctx.Site.RegularPages "Section" "jobs" -}}
{{- $lastBuildDate := now -}}
{{- if gt (len $pages) 0 -}}{{- $lastBuildDate = (index $pages 0).Date -}}{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq  $ctx.Title  $ctx.Site.Title }}{{ $ctx.Site.Title }}{{ else }}{{ with $ctx.Title }}{{.}} on {{ end }}{{ $ctx.Site.Title }}{{ end }} Jobs</title>
    <link>{{ $ctx.Permalink }}#jobs</link>
    <description>Recent job offerings on {{ $ctx.Site.Title }}</description>
    {{ with $ctx.Site.LanguageCode }}<language>{{.}}</language>{{end}}
    {{ with $ctx.Site.Author.email }}<managingEditor>{{.}}{{ with $ctx.Site.Author.name }} ({{.}}){{end}}</managingEditor>{{end}}{{ with $ctx.Site.Author.email }}
    <webMaster>{{.}}{{ with $ctx.Site.Author.name }} ({{.}}){{end}}</webMaster>{{end}}{{ with $ctx.Site.Copyright }}
    <copyright>{{.}}</copyright>{{end}}
    <lastBuildDate>{{ $lastBuildDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    <ttl>1440</ttl>
    {{ with $ctx.OutputFormats.Get $format }}
  {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{ end }}
    {{ range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Params.link }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid isPermaLink="false">{{ .File.BaseFileName }}</guid>
      <description>{{ .Params.place }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
